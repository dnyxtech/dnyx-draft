{
  "name": "dnyx-draft-monorepo",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Local-first Markdown workspace with live preview, multi-format file viewing, a BYOK AI writing assistant, and zero-login IndexedDB storage.",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnyxtech/dnyx-draft.git"
  },
  "homepage": "https://github.com/dnyxtech/dnyx-draft#readme",
  "bugs": {
    "url": "https://github.com/dnyxtech/dnyx-draft/issues"
  },
  "author": "Dnyx Tech",
  "scripts": {
    "dev": "turbo dev --filter=web",
    "dev:landing": "turbo dev --filter=landing",
    "dev:all": "turbo dev",
    "build": "turbo build --filter=web",
    "build:landing": "turbo build --filter=landing",
    "build:all": "turbo build",
    "build:vinext": "turbo build:vinext --filter=web",
    "build:vinext:landing": "turbo build:vinext --filter=landing",
    "build:vinext:all": "turbo build:vinext",
    "deploy:web": "pnpm --filter web deploy:vinext",
    "deploy:landing": "pnpm --filter landing deploy:vinext",
    "start": "pnpm --filter web start",
    "lint": "turbo lint",
    "check": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench": "vitest bench --reporter=verbose",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.49.0",
    "cross-env": "^10.1.0",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.7.0"
}
